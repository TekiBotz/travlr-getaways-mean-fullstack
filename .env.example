# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# HTTP port for the Express server (bin/www). Optional; defaults to 3000.
PORT=3000

# MongoDB connection. app_api/models/db.js builds the URI as:
#   mongodb://<DB_HOST>/travlr
# Optional; defaults to 127.0.0.1. NOTE: the current code reads DB_HOST,
# not MONGO_URI.
DB_HOST=127.0.0.1

# JWT signing secret.
# NOTE: app_api/models/user.js reads JWT_SECRET, but app_api/routes/index.js
# reads JWT_SECRETE (misspelled in the code). Set both to the same value
# until that is corrected.
JWT_SECRET=
JWT_SECRETE=
